# ==============================================================================
# Enterprise Mobile Application - Environment Configuration
# ==============================================================================

# Application Meta
PROJECT_NAME="Enterprise Mobile Application"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (MySQL 8.0 Primary)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="app_user"
DB_PASSWORD="StrongPassword123!"
DB_NAME="app_database"

# Optional: Override with explicit full URI (e.g., sqlite:///./enterprise.db for local offline testing)
# DATABASE_URL="mysql+pymysql://app_user:StrongPassword123!@127.0.0.1:3306/app_database"
DATABASE_URL=""

# JWT Cryptographic Configuration
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="c8b09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration & Rate Limiting
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# SMS Delivery Provider (Twilio Integration)
# If left empty, OTP will print to standard application console logger for development testing
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
